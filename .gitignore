# 原始数据（~430 GB，不进 Git）
data/

# 中间结果、表格、日志（可重跑，不进 Git）
results/intermediate/
results/tables/
logs/

# 图3 的阈值扫描诊断图（每个口径一张、纯中间产物；主线 fig3_attribution_<tag>.png 仍入库）
results/figures/fig3_attribution_sweep_*.png

# 口径切换前的旧图备份（与 results/intermediate|tables 下同名 json/nc 备份同性质，可重跑）
results/figures/*_bak.png
results/figures/*_bak.pdf

# 论文/补充材料 PDF 的纯文本提取（版权内容，与 results/tables/paper_fulltext.txt 同类）
results/paper_text.txt
results/paper_supp_text.txt

# 补充材料 S1 原图及其派生截图（版权内容的位图派生，脚本入库、产物不入库）
results/s1/

# Python 缓存
__pycache__/
*.pyc

# 排除根目录 PDF（论文原文/翻译），保留 results/figures/ 下的出图
/*.pdf

# Python 代码备份压缩包（不入库）
*.zip

# 系统文件
.DS_Store
Thumbs.db
