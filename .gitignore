# 原始数据（~430 GB，不进 Git）
data/

# 中间结果、表格、日志（可重跑，不进 Git）
results/intermediate/
results/tables/
logs/

# 论文/补充材料 PDF 的纯文本提取（版权内容，与 results/tables/paper_fulltext.txt 同类）
results/paper_text.txt
results/paper_supp_text.txt

# Python 缓存
__pycache__/
*.pyc

# 排除根目录 PDF（论文原文/翻译），保留 results/figures/ 下的出图
/*.pdf

# Python 代码备份压缩包（不入库）
*.zip

# 系统文件
.DS_Store
Thumbs.db
